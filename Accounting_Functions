def StraightLineDepreciation(inputs):
    AssetCost = inputs.get("AssetCost")
    SalvageValue = inputs.get("SalvageValue")
    UsefulLife = inputs.get("UsefulLife")
    if None in [AssetCost, SalvageValue, UsefulLife]:
        return None
    StraightLineDepriciationExpense = ((AssetCost - SalvageValue)/UsefulLife)
    return StraightLineDepriciationExpense

def DoubleDecliningBalanceDepreciation(inputs):
    AssetCost = inputs.get("AssetCost")
    SalvageValue = inputs.get("SalvageValue")
    AccumulatedDepreciation = inputs.get("AccumulatedDepreciation")
    UsefulLife = inputs.get("UsefulLife")
    if None in [AssetCost, SalvageValue, AccumulatedDepreciation, UsefulLife]:
        return None
    Book_Value_Begin = AssetCost - AccumulatedDepreciation
    Double_Declining_Balance = (2 / UsefulLife) * Book_Value_Begin
    return Double_Declining_Balance

def UnitOfProductionDepreciation(inputs):
    AssetCost = inputs.get("AssetCost")
    SalvageValue = inputs.get("SalvageValue")
    TotalEstimatedProduction = inputs.get("TotalEstimatedProduction")
    ActualProduction = inputs.get("ActualProduction")
    if None in [AssetCost, SalvageValue, TotalEstimatedProduction, ActualProduction]:
        return None
    UnitsOfProductionDepreciationExpense = ((AssetCost - SalvageValue) / TotalEstimatedProduction) * ActualProduction
    return UnitsOfProductionDepreciationExpense

def FIFOCOGS(inputs):
    PurchaseQuantity1 = inputs.get("PurchaseQuantity1")
    PurchaseQuantity2 = inputs.get("PurchaseQuantity2")
    UnitCost1 = inputs.get("UnitCost1")
    UnitCost2 = inputs.get("UnitCost2")
    UnitsSold = inputs.get("UnitsSold")
    if None in [PurchaseQuantity1, UnitCost1, PurchaseQuantity2, UnitCost2, UnitsSold]:
        return None
    if UnitsSold <= PurchaseQuantity1:
        return UnitsSold * UnitCost1
    else:
        remaining = UnitsSold - PurchaseQuantity1
        return (PurchaseQuantity1 * UnitCost1) + (remaining * UnitCost2)

def LIFOCOGS(inputs):
    PurchaseQuantity1 = inputs.get("PurchaseQuantity1")
    PurchaseQuantity2 = inputs.get("PurchaseQuantity2")
    UnitCost1 = inputs.get("UnitCost1")
    UnitCost2 = inputs.get("UnitCost2")
    UnitsSold = inputs.get("UnitsSold")
    if None in [PurchaseQuantity1, UnitCost1, PurchaseQuantity2, UnitCost2, UnitsSold]:
        return None
    if UnitsSold <= PurchaseQuantity2:
        return UnitsSold * UnitCost2
    else:
        remaining = UnitsSold - PurchaseQuantity2
        return (PurchaseQuantity2 * UnitCost2) + (remaining * UnitCost1)

def WeightedAverageCOGS(inputs):
    PurchaseQuantity1 = inputs.get("PurchaseQuantity1")
    PurchaseQuantity2 = inputs.get("PurchaseQuantity2")
    UnitCost1 = inputs.get("UnitCost1")
    UnitCost2 = inputs.get("UnitCost2")
    UnitsSold = inputs.get("UnitsSold")
    if None in [PurchaseQuantity1, UnitCost1, PurchaseQuantity2, UnitCost2, UnitsSold]:
        return None
    total_cost = (PurchaseQuantity1 * UnitCost1) + (PurchaseQuantity2 * UnitCost2)
    total_units = PurchaseQuantity1 + PurchaseQuantity2
    avg_cost = total_cost / total_units
    return UnitsSold * avg_cost

def AccrualInterest(inputs):
    PrincipalAmount = inputs.get("PrincipalAmount")
    InterestRate = inputs.get("InterestRate")
    Time = inputs.get("Time")
    if None in [PrincipalAmount, InterestRate, Time]:
        return None
    return PrincipalAmount * InterestRate * Time

def AllowanceForDoubtfulAccounts(inputs):
    AccountsReceivable = inputs.get("AccountsReceivable")
    DefaultRateOfUncollectibility = inputs.get("DefaultRateOfUncollectibility")
    if None in [AccountsReceivable, DefaultRateOfUncollectibility]:
        return None
    return DefaultRateOfUncollectibility * AccountsReceivable

def EffectiveInterestAmortization(inputs):
    InitialCarryingAmount = inputs.get("InitialCarryingAmount")
    CouponRate = inputs.get("CouponRate")
    FaceValue = inputs.get("FaceValue")
    EffectiveInterestRate = inputs.get("EffectiveInterestRate")
    if None in [InitialCarryingAmount, CouponRate, FaceValue, EffectiveInterestRate]:
        return None

    cash_paid = FaceValue * CouponRate
    interest_expense = InitialCarryingAmount * EffectiveInterestRate
    amortization = interest_expense - cash_paid
    new_carrying = InitialCarryingAmount + amortization

    return {
        "cash_paid": cash_paid,
        "interest_expense": interest_expense,
        "amortization": amortization,
        "new_carrying": new_carrying
    }

