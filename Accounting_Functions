def ReadInputs(FileName):
    values = {}
    f = open(FileName, "r", encoding="utf-8")
    lines = f.readlines()

    for line in lines:
        for term in TERMS_LIST:
            if term in line:

                value = line.split(":")[1].strip()

                key = term.replace(" ", "")
                values[key] = float(value)

    return values

def GetOutputs(inputs):
    results = {}

    results["StraightLine"] = StraightLineDepreciation(inputs)
    results["DoubleDeclining"] = DoubleDecliningBalanceDepreciation(inputs)
    results["FIFO"] = FIFOCOGS(inputs)
    results["LIFO"] = LIFOCOGS(inputs)
    results["Weighted"] = WeightedAverageCOGS(inputs)
    results["AccrualInterest"] = AccrualInterest(inputs)
    results["Allowance"] = AllowanceForDoubtfulAccounts(inputs)
    results["EffectiveInterest"] = EffectiveInterestAmortization(inputs)

    return results

