        row1 = find_row(distanceTypeInput, imperial_distances)
        row2 = find_row(distanceTypeOutput, imperial_distances)

        factor1 = row1[2]; factor2 = row2[2]; result = (factor1 / factor2) * distanceValue; return result

    elif distanceTypeInput in imperial_distances_list and distanceTypeOutput in metric_distances_list:
        row1 = find_row(distanceTypeInput, imperial_distances)
        row2 = find_row(distanceTypeOutput, metric_distances)

        inches = distanceValue * row1[2]
        meters = inches / meterToInch
        return meters / row2[2]

    elif distanceTypeInput in metric_distances_list and distanceTypeOutput in imperial_distances_list:
        row1 = find_row(distanceTypeInput, metric_distances)
        row2 = find_row(distanceTypeOutput, imperial_distances)

