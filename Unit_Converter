ConversionType = input("Would you like to convert between Temperature, Distance, or Mass (in uppercase)")

def find_row(unit,table):
    for row in table:
        if unit in row[0:2]:
            return row
    return None

def temperature_conversion(temp_type_input, temp_type_output, temp_value):
    if temp_type_input in ("Fahrenheit", "F"):
        if temp_type_output in ("Celsius", "C"):
            result = (temp_value - 32) * 5/9
        elif temp_type_output in ("Kelvin", "K"):
            result = (temp_value - 32) * 5/9 + 273.15

    elif temp_type_input in ("Celsius", "C"):
        if temp_type_output in ("Fahrenheit", "F"):
            result = (temp_value * 9/5) + 32
        elif temp_type_output in ("Kelvin", "K"):
            result = temp_value + 273.15

    elif temp_type_input in ("Kelvin", "K"):
        if temp_type_output in ("Fahrenheit", "F"):
            result = (temp_value - 273.15) * 9/5 + 32
        elif temp_type_output in ("Celsius", "C"):
            result = temp_value - 273.15

    return result

